# udev rules for TWINS serial devices.
#
# Replace the ID_SERIAL_SHORT values with the values reported on your machine:
#
#   udevadm info --query=property --name=/dev/ttyUSB0 | grep '^ID_SERIAL_SHORT='
#
# Then install this file as:
#
#   sudo install -m 644 ./udev/99-twin-arms.rules /etc/udev/rules.d/99-twin-arms.rules
#   sudo udevadm control --reload-rules
#   sudo udevadm trigger --subsystem-match=tty

SUBSYSTEM=="tty", ENV{ID_SERIAL_SHORT}=="LEADER_LEFT_SERIAL", SYMLINK+="leader_arm_left", MODE:="0666", GROUP:="dialout"
SUBSYSTEM=="tty", ENV{ID_SERIAL_SHORT}=="LEADER_RIGHT_SERIAL", SYMLINK+="leader_arm_right", MODE:="0666", GROUP:="dialout"

SUBSYSTEM=="tty", ENV{ID_SERIAL_SHORT}=="FOLLOWER_LEFT_X_SERIAL", SYMLINK+="follower_arm_left_x", MODE:="0666", GROUP:="dialout"
SUBSYSTEM=="tty", ENV{ID_SERIAL_SHORT}=="FOLLOWER_LEFT_P_SERIAL", SYMLINK+="follower_arm_left_p", MODE:="0666", GROUP:="dialout"
SUBSYSTEM=="tty", ENV{ID_SERIAL_SHORT}=="FOLLOWER_RIGHT_X_SERIAL", SYMLINK+="follower_arm_right_x", MODE:="0666", GROUP:="dialout"
SUBSYSTEM=="tty", ENV{ID_SERIAL_SHORT}=="FOLLOWER_RIGHT_P_SERIAL", SYMLINK+="follower_arm_right_p", MODE:="0666", GROUP:="dialout"
